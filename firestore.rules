rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: Check if current user is an authorized admin
    // Checks both custom claims (request.auth.token.admin == true)
    // and verified document role in /users/{uid}.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    // Helper function: Check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function: Validate song schema
    function isValidSong(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.artist is string && data.artist.size() > 0 && data.artist.size() <= 150 &&
             data.youtubeId is string && data.youtubeId.size() >= 5 && data.youtubeId.size() <= 30 &&
             data.category is string &&
             (!('thumbnailUrl' in data) || data.thumbnailUrl is string) &&
             (!('album' in data) || data.album is string);
    }

    // ==========================================
    // 1. Shared Song Catalogue: Public Read, Admin Write
    // ==========================================
    match /songs/{songId} {
      // Anyone can discover and stream songs
      allow read: if true;
      
      // Only authenticated admins can create, modify, or delete songs
      allow create: if isAdmin() && isValidSong(request.resource.data);
      allow update: if isAdmin() && isValidSong(request.resource.data);
      allow delete: if isAdmin();
    }

    // ==========================================
    // 2. User Profiles & Roles
    // ==========================================
    match /users/{userId} {
      // Users can read their own profile; admins can read any profile
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their own profile upon registration, but CANNOT self-assign 'admin' role
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) ||
        request.resource.data.role == 'listener' ||
        isAdmin()
      );
      
      // Users can update their preferences/displayName, but CANNOT escalate their role to 'admin'
      allow update: if isOwner(userId) && (
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) ||
        isAdmin()
      );
      
      // Only super admin can delete user profiles
      allow delete: if isAdmin();
      
      // User's private playlists and likes subcollections
      match /playlists/{playlistId} {
        allow read, write: if isOwner(userId);
      }
      
      match /likes/{songId} {
        allow read, write: if isOwner(userId);
      }

      match /history/{historyId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ==========================================
    // 3. Public Curated Playlists
    // ==========================================
    match /public_playlists/{playlistId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
